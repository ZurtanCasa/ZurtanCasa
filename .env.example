# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Basic Auth (producción Vercel)
BASIC_AUTH_USER=zurtancasa
BASIC_AUTH_PASS=tu_password_seguro

# Shopify
SHOPIFY_STORE_URL=https://tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
# Client ID/Secret de la app "ZurtanCasa Backend API" (Dev Dashboard de Shopify).
# Solo se usan para volver a generar un SHOPIFY_ACCESS_TOKEN vía OAuth si hace falta
# (ver historial de la app/api/shopify-oauth/callback, ya borrada tras el primer uso).
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# MercadoLibre
ML_CLIENT_ID=tu_client_id
ML_CLIENT_SECRET=tu_client_secret
ML_REFRESH_TOKEN=TG-...

# Meta Ads
META_ACCESS_TOKEN=EAA...
META_ACCOUNT_ID=act_1234567890

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=...
GOOGLE_ADS_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-...
GOOGLE_ADS_REFRESH_TOKEN=1//...
GOOGLE_ADS_MANAGER_ID=
GOOGLE_ADS_ACCOUNT_ID=

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=/path/to/service_account.json

# Zeta Software
ZETA_USER=
ZETA_PASS=
ZETA_BASE_URL=

# Club El País (Web Services Consumos)
# CLUB_EL_PAIS_ENV: "testing" mientras la tienda no esté en vivo, "production" cuando se habilite
CLUB_EL_PAIS_ENV=testing
CLUB_EL_PAIS_TEST_USER=
CLUB_EL_PAIS_TEST_PASSWORD=
CLUB_EL_PAIS_PROD_USER=
CLUB_EL_PAIS_PROD_PASSWORD=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_WA=whatsapp:+14155238886
TWILIO_TO_WA=whatsapp:+598...
TWILIO_TEMPLATE_SID=
